{application,uptrack_worker,
    [{modules,
         ['Elixir.UptrackWorker.Application',
          'Elixir.UptrackWorker.Monitoring.Assertions',
          'Elixir.UptrackWorker.Monitoring.CheckClient',
          'Elixir.UptrackWorker.Monitoring.CheckClient.Gun',
          'Elixir.UptrackWorker.Monitoring.CheckClient.Mock',
          'Elixir.UptrackWorker.Monitoring.Consensus',
          'Elixir.UptrackWorker.Monitoring.GunConnection',
          'Elixir.UptrackWorker.Monitoring.MonitorProcess',
          'Elixir.UptrackWorker.Monitoring.MonitorRegistry',
          'Elixir.UptrackWorker.Monitoring.MonitorSupervisor',
          'Elixir.UptrackWorker.Monitoring.MonitorSync']},
     {compile_env,
         [{uptrack_worker,
              [check_client],
              {ok,'Elixir.UptrackWorker.Monitoring.CheckClient.Mock'}},
          {uptrack_worker,[node_region],{ok,us}}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,gun,jason,libcluster]},
     {description,"uptrack_worker"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.UptrackWorker.Application',[]}}]}.
