# Uptrack Worker — Environment Variables
# Copy to .env and fill in values for local development.

# ============================================================================
# CLUSTER CONFIGURATION (required)
# ============================================================================

# Region tag emitted with each check result.
# Common values: eu, us, asia
NODE_REGION=us

# Comma-separated list of main app node addresses for libcluster discovery.
# Use Tailscale IPs in production for encrypted mesh networking.
MAIN_NODES=uptrack@MAIN_NODE_HOST_1,uptrack@MAIN_NODE_HOST_2

# Erlang distribution cookie. MUST match the main app's RELEASE_COOKIE.
# Generate a strong random value (32+ chars) and never commit it:
#   openssl rand -hex 32
RELEASE_COOKIE=generate_a_strong_random_cookie

# ============================================================================
# RUNTIME (required)
# ============================================================================
MIX_ENV=prod

# ============================================================================
# OBSERVABILITY (optional)
# ============================================================================

# AppSignal APM. Leave unset to disable AppSignal entirely.
APPSIGNAL_PUSH_API_KEY=
